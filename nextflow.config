params {
  project_folder    = "$PWD"
  chipfilter_output = null
  macs3_output      = "macs3_output"
  macs3_samplesheet = null
  samples_master    = null
  container_macs3   = "/ictstr01/groups/idc/projects/uhlenhaut/chipseq/singularity_image/macs3-3.0.1.sif"
  container_bedtools = "/ictstr01/groups/idc/projects/uhlenhaut/chipseq/singularity_image/samtools-bedtools-py3.sif"

  seq          = "paired" // or "single"
  genome_size  = 'mm'
  idr_qvalue   = 0.1
  consensus_qvalue = 0.05
  strict_qvalue = 0.01
  run_idr_branch = true
  run_consensus_branch = true
  run_strict_branch = true
  keep_dup     = "all"
  call_summits = true
  write_bedgraph = false
  peak_type    = '' // default narrow; broad: "--broad"
  peak_blacklist_bed = null
  peak_blacklist_fraction = 0.5
  mail_user = 'molendo.hpc@gmail.com'

  cpus   = 4
  memory = "16GB"
  time   = "8h"
}

profiles {
  local { includeConfig 'configs/local.config' }
  hpc   { includeConfig 'configs/slurm.config' }
}
